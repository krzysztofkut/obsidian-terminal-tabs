{
  "name": "obsidian-vault-terminal",
  "version": "0.1.0",
  "description": "Integrated terminal with tabs for Obsidian.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "test": "node test/pty-helper.test.mjs && node test/i18n.test.mjs",
    "install-plugin": "node scripts/install-to-vault.mjs",
    "test:e2e": "npx --yes electron@37 test/e2e/main.cjs"
  },
  "keywords": [
    "obsidian",
    "terminal",
    "xterm"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "builtin-modules": "^5.4.0",
    "esbuild": "^0.28.2",
    "obsidian": "^1.14.4",
    "typescript": "^7.0.2"
  }
}
